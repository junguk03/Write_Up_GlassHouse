# 이 파일을 복사해서 .env 를 만들고, 실제 값을 채워 넣습니다.
#   cp .env.example .env
#
# 반드시 docker compose up -d --build 로 띄웁니다 (컨테이너 잠금 설정이 들어 있습니다).

# Flask 세션 서명에 쓰이는 비밀키
SECRET_KEY=change-me

# 운영진 계정 비밀번호
ADMIN_PASSWORD=change-me

# 운영진 이메일. 비밀번호 찾기에 씁니다
ADMIN_EMAIL=change-me@glasshouse.ac.kr

# 플래그
FLAG_H07_SANTA=GlassHouse{여기에_실제_플래그를_넣습니다}
