# 이 파일을 복사해서 .env 를 만들고, 실제 값을 채워 넣습니다.
#   cp .env.example .env
#
# 이 문제는 .env 말고도 서버에 직접 두는 파일이 두 개 있습니다. 둘 다 깃에 올리지 않습니다.
#   keys/ticket_key.json    초대권 서명 키  (keys/ticket_key.example.json 을 복사해서 secret 을 바꿉니다)
#   vault/flag-<무작위>.txt  플래그. 파일 이름을 추측할 수 없게 만듭니다
#
# 반드시 docker compose up -d --build 로 띄웁니다 (컨테이너 잠금 설정이 들어 있습니다).

# Flask 세션 서명에 쓰이는 비밀키
SECRET_KEY=dev-only-change-me
