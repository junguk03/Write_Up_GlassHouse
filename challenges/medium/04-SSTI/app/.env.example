# 이 파일을 복사해서 .env 를 만들고, 실제 값을 채워 넣습니다.
#   cp .env.example .env
#
# .env 는 .gitignore 에 등록되어 있어 깃에 올라가지 않습니다.
# 소스는 전부 공개되므로, 알면 바로 뚫리는 값은 모두 여기에 둡니다.
# 문제를 만들 때는 아래 값을 전부 바꿉니다 (docs/RULES.md 1-3, 1-4).

# Flask 세션 서명에 쓰이는 비밀키
SECRET_KEY=dev-only-change-me

# 심사위원(reviewer) 계정 비밀번호
ADMIN_PASSWORD=adminpw

# 심사위원(reviewer) 이메일. 비밀번호 찾기에 씁니다
ADMIN_EMAIL=reviewer@glasshouse.ac.kr

# 문제별 플래그 (CTF 문제를 만들 때 사용)
FLAG_IDOR=GlassHouse{여기에_실제_플래그를_넣습니다}
